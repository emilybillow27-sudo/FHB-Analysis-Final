# Keep this project's dependency library and cache local.
Sys.setenv(
  RENV_PATHS_LIBRARY = file.path(getwd(), "renv/library"),
  RENV_PATHS_CACHE = file.path(getwd(), "renv/cache"),
  RENV_PATHS_ROOT = file.path(getwd(), "renv/state"),
  RENV_PATHS_SANDBOX = file.path(getwd(), "renv/sandbox")
)
source("renv/activate.R")
